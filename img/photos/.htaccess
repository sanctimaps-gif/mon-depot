# Dossier de dépôt : uniquement des images, jamais de code exécutable.
php_flag engine off
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
